# Supabase project URL and publishable key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; consumed only by the signed Discord interaction route.
SUPABASE_SERVICE_ROLE_KEY=
# Official Discord Application interaction configuration.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ATTENDANCE_CHANNEL_ID=
DISCORD_GUILD_ID=
# Used locally by scripts/register-discord-commands.mjs; never expose to the browser.
DISCORD_BOT_TOKEN=
